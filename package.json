{
  "name": "dsh-vsceditor",
  "version": "0.2.0",
  "description": "Embedded code-server (full VSCode) panel for DeepSeek Harness sessions, with ACP-style edit sync, red/green diff follow mode and file locking via the bundled dsh-bridge VSCode extension.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "dsh-plugin",
    "code-server",
    "vscode",
    "editor"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k-ying/dsh-vsceditor.git"
  },
  "homepage": "https://github.com/k-ying/dsh-vsceditor#readme",
  "bugs": "https://github.com/k-ying/dsh-vsceditor/issues",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "vscode-ext/dsh-bridge",
    "scripts",
    "cordis.patch.yml"
  ],
  "scripts": {
    "install:editor": "sh scripts/install-code-server.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  }
}
